# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://gateforge_user:gateforge_password@localhost:5432/gateforge_db?schema=public"

# Redis Configuration (Rate Limiting & BullMQ Queue)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# Service Ports
GATEWAY_PORT=3000
WORKER_PORT=3002
DASHBOARD_PORT=3001

# Application Settings
NODE_ENV="development"
GATEWAY_SECRET="super-secret-gateway-signing-key"
